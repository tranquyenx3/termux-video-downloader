#!/data/data/com.termux/files/usr/bin/bash
# Termux Video Downloader V4.7 AUTO MEDIA
set -u

BASE="$HOME/storage/shared/Download/Termux Video Downloader"
VIDEO="$BASE/Video"
AUDIO="$BASE/Audio"
THUMB="$BASE/Thumbnail"
CONVERT="$BASE/Converted"
HIST="$BASE/History"
mkdir -p "$VIDEO" "$AUDIO" "$THUMB" "$CONVERT" "$HIST"

command -v yt-dlp >/dev/null 2>&1 || { echo "Chưa có yt-dlp. Chạy: bash install.sh"; exit 1; }
command -v ffmpeg >/dev/null 2>&1 || { echo "Chưa có ffmpeg. Chạy: pkg install ffmpeg"; exit 1; }

cyan="\033[36m"; blue="\033[34m"; green="\033[32m"; yellow="\033[33m"; red="\033[31m"; reset="\033[0m"

banner() {
  clear
  printf "${cyan}"
  printf '+--------------------------------------------------------------+\n'
  printf '|              TERMUX VIDEO DOWNLOADER V4.7                   |\n'
  printf '|                    AUTO MEDIA PRO                           |\n'
  printf '+--------------------------------------------------------------+\n'
  printf "${reset}"
}

pause(){ echo; read -r -p "Enter để tiếp tục..." _; }

get_url() {
  local u="${1:-}"
  if [ -n "$u" ]; then URL="$u"; return; fi
  echo "URL nguồn (YouTube/TikTok/Douyin/Facebook/ZingMP3/...):"
  read -r URL
  URL="${URL#\'}"; URL="${URL%\'}"
  URL="${URL#\"}"; URL="${URL%\"}"
}

detect() {
  echo
  echo -e "${yellow}Đang tự nhận dạng nguồn + lấy metadata...${reset}"
  yt-dlp --no-warnings --skip-download --print "%(extractor_key)s|%(title)s|%(duration_string)s|%(webpage_url_domain)s" "$URL" 2>/dev/null | head -n 1
}

video() {
  get_url "${1:-}"
  detect
  echo
  echo -e "${blue}CHỌN CHẤT LƯỢNG VIDEO${reset}"
  echo "[1] Tốt nhất có thể"
  echo "[2] 4K / <=2160p"
  echo "[3] 2K / <=1440p"
  echo "[4] Full HD / <=1080p"
  echo "[5] HD / <=720p"
  echo "[6] SD / <=480p"
  echo "[7] Xem toàn bộ format thực tế"
  read -r -p "Chọn [1-7]: " q
  case "$q" in
    1) F='bv*+ba/b' ;;
    2) F='bv*[height<=2160]+ba/b[height<=2160]' ;;
    3) F='bv*[height<=1440]+ba/b[height<=1440]' ;;
    4) F='bv*[height<=1080]+ba/b[height<=1080]' ;;
    5) F='bv*[height<=720]+ba/b[height<=720]' ;;
    6) F='bv*[height<=480]+ba/b[height<=480]' ;;
    7) yt-dlp -F "$URL"; pause; return ;;
    *) echo "Lựa chọn không hợp lệ"; return ;;
  esac
  echo -e "${green}Đang tải...${reset}"
  yt-dlp --newline --no-playlist --merge-output-format mp4 \
    -f "$F" -o "$VIDEO/%(extractor_key)s/%(title)s [%(id)s].%(ext)s" "$URL" \
    && echo "$(date '+%F %T') VIDEO $URL" >> "$HIST/download.log"
  pause
}

audio() {
  get_url "${1:-}"
  detect
  echo
  echo -e "${blue}CHỌN ÂM THANH${reset}"
  echo "[1] MP3 320 kbps"
  echo "[2] MP3 256 kbps"
  echo "[3] MP3 192 kbps"
  echo "[4] MP3 128 kbps"
  echo "[5] M4A/AAC"
  echo "[6] OPUS"
  echo "[7] FLAC (chỉ hợp lý nếu nguồn có chất lượng tương ứng)"
  echo "[8] WAV"
  read -r -p "Chọn [1-8]: " q
  case "$q" in
    1) pp='mp3'; br='320K' ;;
    2) pp='mp3'; br='256K' ;;
    3) pp='mp3'; br='192K' ;;
    4) pp='mp3'; br='128K' ;;
    5) pp='m4a'; br='' ;;
    6) pp='opus'; br='' ;;
    7) pp='flac'; br='' ;;
    8) pp='wav'; br='' ;;
    *) echo "Lựa chọn không hợp lệ"; return ;;
  esac
  args=(--newline --no-playlist -x --audio-format "$pp" --audio-quality 0
        -o "$AUDIO/%(extractor_key)s/%(title)s [%(id)s].%(ext)s")
  [ -n "$br" ] && args+=(--postprocessor-args "ffmpeg:-b:a $br")
  echo -e "${green}Đang tải và chuyển đổi...${reset}"
  yt-dlp "${args[@]}" "$URL" \
    && echo "$(date '+%F %T') AUDIO $URL" >> "$HIST/download.log"
  pause
}

convert() {
  get_url "${1:-}"
  echo
  echo "[1] Tải video rồi xuất MP4"
  echo "[2] Tải video rồi xuất MKV"
  echo "[3] Tải video rồi xuất WEBM"
  echo "[4] Chọn format nguồn rồi chuyển đổi"
  read -r -p "Chọn [1-4]: " q
  case "$q" in
    1) ext=mp4; codec='libx264'; ac='aac' ;;
    2) ext=mkv; codec='libx264'; ac='aac' ;;
    3) ext=webm; codec='libvpx-vp9'; ac='libopus' ;;
    4) yt-dlp -F "$URL"; read -r -p "Nhập format ID: " fid
       yt-dlp --newline --no-playlist -f "$fid" \
       -o "$CONVERT/%(title)s [%(id)s].%(ext)s" "$URL"; pause; return ;;
    *) echo "Lựa chọn không hợp lệ"; return ;;
  esac
  echo "Chọn chất lượng đầu ra:"
  echo "[1] Cao  (CRF 18)"
  echo "[2] Cân bằng (CRF 23)"
  echo "[3] Nhẹ (CRF 28)"
  read -r -p "Chọn [1-3]: " cq
  case "$cq" in 1) crf=18;;2) crf=23;;3) crf=28;;*) crf=23;; esac
  tmp="$CONVERT/.tmp-%(id)s.%(ext)s"
  echo -e "${green}Đang tải + chuyển đổi...${reset}"
  yt-dlp --newline --no-playlist -f 'bv*+ba/b' \
    -o "$tmp" "$URL" || { pause; return; }
  # Find newest media and transcode it.
  src="$(find "$CONVERT" -maxdepth 1 -type f -name '.tmp-*' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)"
  [ -z "${src:-}" ] && { echo "Không tìm thấy file tạm."; pause; return; }
  out="${src/.tmp-/.}"
  out="${out%.*}.$ext"
  ffmpeg -hide_banner -y -i "$src" -c:v "$codec" -crf "$crf" -c:a "$ac" "$out"
  rm -f "$src"
  pause
}

thumb() {
  get_url "${1:-}"
  yt-dlp --no-playlist --write-thumbnail --skip-download \
    --convert-thumbnails jpg \
    -o "$THUMB/%(extractor_key)s/%(title)s [%(id)s].%(ext)s" "$URL"
  pause
}

info() {
  get_url "${1:-}"
  yt-dlp --no-playlist --print "%(extractor)s\n%(extractor_key)s\n%(title)s\n%(channel)s\n%(duration_string)s\n%(resolution)s\n%(fps)s\n%(filesize_approx)s\n%(webpage_url)s" "$URL"
  echo
  yt-dlp -F "$URL"
  pause
}

history() {
  echo "=== LỊCH SỬ ==="
  [ -f "$HIST/download.log" ] && tail -n 50 "$HIST/download.log" || echo "Chưa có lịch sử."
  pause
}

open_dir() {
  termux-open "$BASE" >/dev/null 2>&1 || true
  echo "Thư mục:"
  echo "$BASE"
  pause
}

system_check() {
  echo "=== HỆ THỐNG ==="
  echo "yt-dlp: $(yt-dlp --version 2>/dev/null || echo N/A)"
  echo "ffmpeg: $(ffmpeg -version 2>/dev/null | head -n1 || echo N/A)"
  echo "Python: $(python --version 2>&1)"
  echo
  echo "Dung lượng:"
  df -h "$HOME/storage/shared" 2>/dev/null || df -h "$HOME"
  pause
}

sources() {
  echo "yt-dlp có extractor cho rất nhiều website; không thể cam kết mọi URL."
  echo "Ví dụ hiện có: YouTube, TikTok, Douyin, Facebook, ZingMP3 và nhiều nguồn khác."
  echo "ZingMP3 hiện có extractor zingmp3 theo danh sách hỗ trợ của yt-dlp."
  echo
  echo "Kiểm tra trực tiếp một URL bằng mục [5] Thông tin + định dạng."
  pause
}

share_queue() {
  echo "=== SHARE MODE ==="
  echo "Dùng: vdown-share 'URL'"
  echo "Lịch sử share:"
  tail -n 30 "$HIST/share.log" 2>/dev/null || echo "Chưa có."
  pause
}

main_menu() {
  while true; do
    banner
    echo -e "${blue}MENU CHÍNH${reset}"
    echo "[1] 🎬 Tải Video"
    echo "[2] 🎵 Tải Nhạc"
    echo "[3] 🔄 Video → Video"
    echo "[4] 🖼 Tải Thumbnail"
    echo "[5] 🔎 Thông tin + format thực tế"
    echo "[6] 📜 Lịch sử tải"
    echo "[7] ⬆ Cập nhật yt-dlp"
    echo "[8] 📂 Mở thư mục Video"
    echo "[9] ⚙ Kiểm tra hệ thống"
    echo "[10] 🌐 Nguồn hỗ trợ"
    echo "[11] 📲 Share Mode"
    echo "[0] Thoát"
    echo
    read -r -p "VDown > " n
    case "$n" in
      1) video ;;
      2) audio ;;
      3) convert ;;
      4) thumb ;;
      5) info ;;
      6) history ;;
      7) python -m pip install -U yt-dlp; pause ;;
      8) open_dir ;;
      9) system_check ;;
      10) sources ;;
      11) share_queue ;;
      0) exit 0 ;;
      *) echo "Sai lựa chọn"; sleep 1 ;;
    esac
  done
}

# URL passed as argument = one-shot auto media mode.
if [ $# -gt 0 ]; then
  URL="$*"
  echo "VDown AUTO MEDIA"
  echo "URL: $URL"
  echo
  detect
  echo
  echo "[1] Video tốt nhất"
  echo "[2] Audio MP3 320"
  echo "[3] Xem format thực tế"
  echo "[0] Hủy"
  read -r -p "Chọn: " q
  case "$q" in
    1) video "$URL" ;;
    2) audio "$URL" ;;
    3) info "$URL" ;;
    *) exit 0 ;;
  esac
else
  main_menu
fi
