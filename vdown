#!/data/data/com.termux/files/usr/bin/bash

VERSION="4.4 ALL SOURCES"
TẢI VIDEO_ROOT="$HOME/storage/downloads/Video"
CONFIG_DIR="$HOME/.config/vdown"
HISTORY_FILE="$CONFIG_DIR/history.log"
mkdir -p "$TẢI VIDEO_ROOT" "$CONFIG_DIR"

# ANSI colors: use $'...' so Termux interprets escape codes correctly.
RESET=$'\033[0m'
BOLD=$'\033[1m'
CYAN=$'\033[1;36m'
BLUE=$'\033[1;34m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[1;31m'
WHITE=$'\033[1;37m'
DIM=$'\033[2m'

term_width() {
    local w
    w=$(tput cols 2>/dev/null || echo 50)
    [ "$w" -gt 70 ] && w=70
    [ "$w" -lt 42 ] && w=42
    echo "$w"
}

line() {
    local n="$1"
    printf '%*s' "$n" '' | tr ' ' '-'
}

header() {
    clear
    local w inner
    w=$(term_width)
    inner=$((w-4))

    printf '%s+%s+%s\n' "$CYAN" "$(line "$((w-2))")" "$RESET"
    printf '%s|%*s%*s|%s\n' "$CYAN" $(( (inner+24)/2 )) "TERMUX VIDEO TẢI VIDEOER" $(( (inner-24)/2 )) "" "$RESET"
    printf '%s|%*s%*s|%s\n' "$CYAN" $(( (inner+10)/2 )) "V$VERSION" $(( (inner-10)/2 )) "" "$RESET"
    printf '%s+%s+%s\n\n' "$CYAN" "$(line "$((w-2))")" "$RESET"
}

section() {
    printf '%s%s  %s%s\n' "$BLUE" "$BOLD" "$1" "$RESET"
}

pause() {
    echo
    read -r -p "  ${DIM}Nhấn Enter để tiếp tục...${RESET}" _
}

notify() {
    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification --id 4040 --title "VDown" --content "$1" >/dev/null 2>&1 || true
    fi
}

choose_site_dir() {
    case "$1" in
        *tiktok.com*|*douyin.com*|*iesdouyin.com*) echo "TikTok-Douyin" ;;
        *youtube.com*|*youtu.be*) echo "YouTube" ;;
        *facebook.com*|*fb.watch*) echo "Facebook" ;;
        *instagram.com*) echo "Instagram" ;;
        *x.com*|*twitter.com*) echo "X-Twitter" ;;
        *reddit.com*) echo "Reddit" ;;
        *vimeo.com*) echo "Vimeo" ;;
        *dailymotion.com*) echo "Dailymotion" ;;
        *weibo.com*) echo "Weibo" ;;
        *xiaohongshu.com*|*xhslink.com*) echo "Xiaohongshu" ;;
        *bilibili.com*) echo "Bilibili" ;;
        *vk.com*) echo "VK" ;;
        *twitch.tv*) echo "Twitch" ;;
        *pinterest.com*) echo "Pinterest" ;;
        *tumblr.com*) echo "Tumblr" ;;
        *linkedin.com*) echo "LinkedIn" ;;
        *threads.net*) echo "Threads" ;;
        *snapchat.com*) echo "Snapchat" ;;
        *likee.video*|*likee.com*) echo "Likee" ;;
        *kwai.com*|*kuaishou.com*) echo "Kwai" ;;
        *nicovideo.jp*) echo "Niconico" ;;
        *) echo "Other" ;;
    esac
}

get_url() {
    local n
    section "NGUỒN URL"
    echo "  [1] Nhập / dán URL"
    echo "  [2] Clipboard"
    echo
    read -r -p "  Chọn [1-2]: " n
    case "$n" in
        1) read -r -p "  URL: " URL ;;
        2)
            if command -v termux-clipboard-get >/dev/null 2>&1; then
                URL="$(termux-clipboard-get 2>/dev/null)"
                echo "  Clipboard: ${URL:0:65}"
            else
                echo -e "${RED}  X Clipboard command unavailable${RESET}"
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
    [ -n "${URL:-}" ] || {
        echo -e "${RED}  X URL trống${RESET}"
        return 1
    }
}

supported_sources() {
    header
    section "NGUỒN HỖ TRỢ TỰ ĐỘNG"
    echo
    echo "  VDown dùng yt-dlp để tự nhận diện URL."
    echo
    echo "  Mạng xã hội phổ biến:"
    echo "  • TikTok / Douyin"
    echo "  • YouTube / Shorts"
    echo "  • Facebook / Reels"
    echo "  • Instagram / Reels"
    echo "  • X (Twitter)"
    echo "  • Reddit"
    echo "  • Vimeo / Dailymotion"
    echo "  • Weibo / Xiaohongshu"
    echo "  • Bilibili / VK"
    echo "  • Twitch / Pinterest"
    echo "  • Tumblr / LinkedIn / Threads"
    echo "  • Snapchat / Likee / Kwai"
    echo
    echo "  Ngoài ra còn rất nhiều website khác."
    echo "  URL không nằm trong danh sách vẫn có thể"
    echo "  hoạt động qua bộ trích xuất generic."
    echo
    echo "  Lưu ý: website thay đổi liên tục; không phải"
    echo "  URL nào cũng được đảm bảo tải thành công."
    pause
}

quality_menu() {
    echo
    section "CHẤT LƯỢNG VIDEO"
    echo "  [1] Tốt nhất"
    echo "  [2] 4K       2160p"
    echo "  [3] 2K       1440p"
    echo "  [4] FULL HD  1080p"
    echo "  [5] HD        720p"
    echo "  [6] SD        480p"
    echo
    read -r -p "  Select [1-6]: " q
    case "$q" in
        2) echo "2160" ;;
        3) echo "1440" ;;
        4) echo "1080" ;;
        5) echo "720" ;;
        6) echo "480" ;;
        *) echo "best" ;;
    esac
}

quality_format() {
    case "$1" in
        2160) echo "bv*[height<=2160]+ba/b" ;;
        1440) echo "bv*[height<=1440]+ba/b" ;;
        1080) echo "bv*[height<=1080]+ba/b" ;;
        720)  echo "bv*[height<=720]+ba/b" ;;
        480)  echo "bv*[height<=480]+ba/b" ;;
        *) echo "bv*+ba/b" ;;
    esac
}

download_video() {
    local URL="$1"
    local QUALITY="${2:-best}"
    local SITE DIR FORMAT
    SITE="$(choose_site_dir "$URL")"
    DIR="$TẢI VIDEO_ROOT/$SITE"
    FORMAT="$(quality_format "$QUALITY")"
    mkdir -p "$DIR"

    header
    section "TẢI VIDEO"
    echo "  Nguồn       : $SITE"
    echo "  Chất lượng  : $QUALITY"
    echo "  Lưu tại     : $DIR"
    echo "  URL        : ${URL:0:65}"
    echo
    echo -e "${CYAN}${BOLD}  TẢI VIDEOING...${RESET}"
    echo

    if yt-dlp \
        --no-playlist \
        --newline \
        --progress \
        --retries 5 \
        --fragment-retries 5 \
        --concurrent-fragments 4 \
        --socket-timeout 20 \
        -f "$FORMAT" \
        --merge-output-format mp4 \
        --embed-metadata \
        --windows-filenames \
        -o "$DIR/%(title).180B [%(id)s].%(ext)s" \
        "$URL"
    then
        printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$SITE" "$URL" >> "$HISTORY_FILE"
        echo
        echo -e "${GREEN}${BOLD}  [OK] TẢI VIDEO COMPLETE${RESET}"
        echo "  Thư mục: $DIR"
        notify "Tải xong - $SITE"
        return 0
    else
        echo
        echo -e "${RED}${BOLD}  [ERROR] TẢI VIDEO FAILED${RESET}"
        notify "Tải lỗi - $SITE"
        return 1
    fi
}

download_audio() {
    local URL="$1"
    local SITE DIR
    SITE="$(choose_site_dir "$URL")"
    DIR="$TẢI VIDEO_ROOT/$SITE/Audio"
    mkdir -p "$DIR"

    header
    section "MP3 TẢI VIDEO"
    echo "  Source: $SITE"
    echo

    if yt-dlp \
        --no-playlist --newline --progress --retries 5 \
        -f "ba/b" -x --audio-format mp3 --audio-quality 0 \
        --embed-metadata --windows-filenames \
        -o "$DIR/%(title).180B [%(id)s].%(ext)s" "$URL"
    then
        echo
        echo -e "${GREEN}${BOLD}  [OK] TẢI MP3 HOÀN TẤT${RESET}"
        notify "Tải MP3 xong - $SITE"
        return 0
    fi

    echo -e "${RED}  [LỖI] TẢI MP3 THẤT BẠI${RESET}"
    return 1
}

download_thumbnail() {
    local URL="$1"
    local SITE DIR
    SITE="$(choose_site_dir "$URL")"
    DIR="$TẢI VIDEO_ROOT/$SITE/Thumbnails"
    mkdir -p "$DIR"

    header
    section "THUMBNAIL"
    echo
    yt-dlp --no-playlist --skip-download --write-thumbnail \
        --convert-thumbnails jpg --windows-filenames \
        -o "$DIR/%(title).180B [%(id)s].%(ext)s" "$URL"
}

show_info() {
    header
    section "THÔNG TIN MEDIA"
    yt-dlp --no-playlist --dump-single-json --skip-download "$1" 2>/dev/null |
    python -c '
import json,sys
try:
    d=json.load(sys.stdin)
    for k in ("title","uploader","channel","duration","upload_date","webpage_url"):
        if d.get(k) is not None:
            print(f"  {k:<12}: {d[k]}")
except Exception:
    pass
'
    echo
    section "CÁC ĐỊNH DẠNG CÓ SẴN"
    yt-dlp --no-playlist --list-formats "$1"
}

batch_download() {
    local LIST URL
    header
    section "BATCH TẢI VIDEO"
    read -r -p "  URL file [~/urls.txt]: " LIST

    [ -f "$LIST" ] || {
        echo -e "${RED}  X Không tìm thấy file${RESET}"
        pause
        return
    }

    while IFS= read -r URL || [ -n "$URL" ]; do
        [ -z "$URL" ] && continue
        case "$URL" in \#*) continue ;; esac
        download_video "$URL" "best" || true
    done < "$LIST"

    pause
}

history_view() {
    header
    section "TẢI VIDEO HISTORY"
    if [ -f "$HISTORY_FILE" ]; then
        tail -30 "$HISTORY_FILE"
    else
        echo "  Chưa có lượt tải nào."
    fi
    pause
}

system_check() {
    header
    section "TRẠNG THÁI HỆ THỐNG"
    echo "  VDown        : $VERSION"
    echo "  yt-dlp       : $(yt-dlp --version 2>/dev/null || echo missing)"
    echo "  Python       : $(python --version 2>&1)"
    echo "  FFmpeg       : $(ffmpeg -version 2>&1 | head -1)"
    echo "  Thông báo    : $(command -v termux-notification >/dev/null 2>&1 && echo ON || echo OFF)"
    echo "  Thư mục lưu  : $TẢI VIDEO_ROOT"
    pause
}

update_tool() {
    header
    section "CẬP NHẬT YT-DLP"
    python -m pip install -U "yt-dlp[default]"
    echo
    echo "  Phiên bản hiện tại: $(yt-dlp --version)"
    pause
}

open_folder() {
    if command -v termux-open >/dev/null 2>&1; then
        termux-open "$TẢI VIDEO_ROOT" >/dev/null 2>&1 || true
    else
        echo "$TẢI VIDEO_ROOT"
        pause
    fi
}

menu() {
    while true; do
        header
        section "MENU CHÍNH"
        echo
        echo -e "  ${CYAN}[1]${RESET}  Tải Video"
        echo -e "  ${CYAN}[2]${RESET}  Tải MP3"
        echo -e "  ${CYAN}[3]${RESET}  Tải Thumbnail"
        echo -e "  ${CYAN}[4]${RESET}  Tải hàng loạt"
        echo -e "  ${CYAN}[5]${RESET}  Thông tin + định dạng"
        echo -e "  ${CYAN}[6]${RESET}  Lịch sử tải"
        echo -e "  ${CYAN}[7]${RESET}  Cập nhật yt-dlp"
        echo -e "  ${CYAN}[8]${RESET}  Mở thư mục Video"
        echo -e "  ${CYAN}[9]${RESET}  Kiểm tra hệ thống"
        echo -e "  ${CYAN}[10]${RESET} Danh sách nguồn hỗ trợ"
        echo -e "  ${RED}[0]${RESET}  Thoát"
        echo
        echo -e "  ${DIM}------------------------------------------${RESET}"
        read -r -p "  ${WHITE}VDown > ${RESET}" c

        case "$c" in
            1) get_url || continue; Q="$(quality_menu)"; download_video "$URL" "$Q"; pause ;;
            2) get_url || continue; download_audio "$URL"; pause ;;
            3) get_url || continue; download_thumbnail "$URL"; pause ;;
            4) batch_download ;;
            5) get_url || continue; show_info "$URL"; pause ;;
            6) history_view ;;
            7) update_tool ;;
            8) open_folder ;;
            9) system_check ;;
            10) supported_sources ;;
            0) clear; exit 0 ;;
            *) echo -e "${RED}  X Lựa chọn không hợp lệ${RESET}"; sleep 1 ;;
        esac
    done
}

case "${1:-}" in
    --help|-h)
        echo 'vdown "URL"'
        echo 'vdown --audio "URL"'
        echo 'vdown --info "URL"'
        ;;
    --audio)
        download_audio "$2"
        ;;
    --info)
        show_info "$2"
        ;;
    "")
        menu
        ;;
    *)
        download_video "$1" "${2:-best}"
        ;;
esac
